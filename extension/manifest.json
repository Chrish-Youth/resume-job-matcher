{
  "manifest_version": 3,
  "name": "职得岗位采集助手",
  "version": "1.4.0",
  "description": "连续采集并复核智联招聘和 BOSS 直聘岗位详情，支持定时补跑、桌面通知和反馈学习。",
  "permissions": ["activeTab", "tabs", "alarms", "notifications", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://*.zhaopin.com/*",
    "https://zhaopin.com/*",
    "https://*.zhipin.com/*",
    "https://zhipin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "采集当前页岗位",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhaopin.com/*",
        "https://zhaopin.com/*",
        "https://*.zhipin.com/*",
        "https://zhipin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
