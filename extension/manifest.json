{
  "manifest_version": 3,
  "name": "职得岗位采集助手",
  "version": "1.1.0",
  "description": "按岗位雷达计划连续采集智联招聘和 BOSS 直聘公开职位，并发送到本地简历匹配助手。",
  "permissions": ["activeTab", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://*.zhaopin.com/*",
    "https://zhaopin.com/*",
    "https://*.zhipin.com/*",
    "https://zhipin.com/*"
  ],
  "action": {
    "default_title": "采集当前页岗位",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhaopin.com/*",
        "https://zhaopin.com/*",
        "https://*.zhipin.com/*",
        "https://zhipin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
